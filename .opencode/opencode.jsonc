{
  // Project config for this repository, and the reference setup for the plugin.
  // Copy the `permissions` block into your own opencode.json(c); the rest is repo-local.
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  // Layer 1: deterministic rules, evaluated before any plugin runs. Last matching rule wins,
  // and a `deny` here is final — the plugin's evaluate hook is never consulted for it.
  "permissions": [
    // Default-deny shell: the agent asks before running anything, and we allow back what is safe.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "npm run *", "effect": "allow" },
    { "action": "shell", "resource": "npx tsc *", "effect": "allow" },

    // Irreversible file and history operations. The plugin repeats these as regex rules, because
    // a glob cannot express `git push --force-with-lease` and `git push -f` in one pattern.
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "rmdir *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "deny" },
    { "action": "shell", "resource": "del *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },

    // Credential files. `*.env` also matches a path tail such as /repo/deploy/.env; the later
    // `allow` rules keep placeholder templates usable, since the last match wins.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.sample", "effect": "allow" },

    // Cluster credentials live outside the project, so `external_directory` gates them first.
    // `$HOME` is expanded before matching, which is why it works for both `~/.kube` and absolute
    // paths. Add your own sensitive directories here; the plugin covers `.ssh`, `.aws`, `.gnupg`.
    { "action": "read", "resource": "$HOME/.kube/*", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.kube/*", "effect": "deny" },

    // Anything outside the project directory needs an explicit yes. OpenCode allows this by
    // default, so turning it into `ask` is the single highest-value rule in this file. The two
    // allows below only cover OpenCode's own data and scratch directories.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "$HOME/.kube/*", "effect": "deny" },
    { "action": "external_directory", "resource": "$HOME/.kube", "effect": "deny" },
    { "action": "external_directory", "resource": "$HOME/.local/share/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "$HOME/AppData/Local/Temp/opencode/*", "effect": "allow" }
  ]

  // To load the plugin from npm instead of copying the file into .opencode/plugins/, replace the
  // comment markers and set the classifier model to one you actually have credentials for:
  //
  // "plugins": [
  //   {
  //     "package": "opencode-hook-safety",
  //     "options": { "classifier": false, "shellTimeoutMs": 300000 }
  //   }
  // ]
}
